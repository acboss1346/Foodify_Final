{
  "version": 2,
  "builds": [

    {
      "src": "server/index.js",
      "use": "@vercel/node",
      "config": {
        "maxLambdaSize": "15mb" 
      }
    },

    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "buildCommand": "npm run build", 
        "outputDirectory": "dist"
      }
    }
  ],
  "routes": [

    {
      "src": "/api/(.*)",
      "dest": "server/index.js"
    },

    {
      "src": "/(.*)",
      "dest": "client/dist/index.html" 
    }
  ]
}